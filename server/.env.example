# Copy this file to `.env` in the server/ directory and edit as needed.
# Never put paid-service credentials here. CodeShare requires none.

# HTTP port for the signaling server (and, if client/dist exists, the built frontend).
PORT=4000

# Comma-separated list of browser origins allowed to open a WebSocket to this server.
# For local development the Vite dev server runs on http://localhost:5173.
CLIENT_ORIGIN=http://localhost:5173

# development | production
NODE_ENV=development

# Minutes before an unused transfer session expires and its code stops working.
SESSION_TTL_MINUTES=15

# Maximum failed join attempts per IP address per transfer code before that
# address is blocked for the session's lifetime.
MAX_JOIN_ATTEMPTS=5

# Hard cap on receivers per one-to-many ("group") transfer. The sender picks a
# smaller group size in the UI; this is the server-side upper bound.
MAX_RECEIVERS=10

# Optional hardening (defaults shown; uncomment to override):
#
# Maximum live sessions a single IP address may hold at once.
#MAX_SESSIONS_PER_IP=10
#
# Signaling events (create/join/approve/signal/...) allowed per socket per minute.
#MAX_SIGNALS_PER_MINUTE=600
#
# Set to 1 ONLY when this server runs behind a reverse proxy (nginx, Render, etc.)
# that overwrites the X-Forwarded-For header. Used solely for rate-limit keys.
#TRUST_PROXY=1
#
# Set to 1 to also serve the built frontend from client/dist on this server,
# so one free host can run both the site and the signaling server.
#SERVE_CLIENT=1
