# Copy this file to `.env` in the client/ directory if you need to change the
# signaling server URL. No secrets belong in frontend code - this is only a
# public endpoint address.

# Full URL of the CodeShare signaling server.
# Leave EMPTY to use the same origin as the frontend. Same-origin works when:
#   - running `npm run dev` (the Vite dev server proxies /socket.io to :4000), or
#   - the signaling server also serves the built frontend (SERVE_CLIENT=1).
VITE_SIGNALING_URL=http://localhost:4000
